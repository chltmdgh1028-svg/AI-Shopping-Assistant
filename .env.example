# Copy to .env.local for local development. Never commit real values.
# On Vercel: Project -> Settings -> Environment Variables.

# Google AI Studio API key (https://aistudio.google.com/apikey). Server-side only.
# Leave empty to run without AI: the app then uses deterministic page extraction plus manual input.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite. Any stable Gemini model id that supports structured output.
GEMINI_MODEL=
